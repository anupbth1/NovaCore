# NovaCore .gitignore

# Model weights (large binary files - generate locally)
weights/
*.ncw
*.pkl

# Pool data and cache
data/hf_cache/
data/conversational_pool/
data/conversational_train.jsonl

# Knowledge base files (generated during encoding)
*_knowledge.json
*_index.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temp files
*.tmp
*.bak
*.log

# Jupyter
.ipynb_checkpoints/

# Keep config files
!config/*.json
